  "server": {
    "port": 4848
  },
  "week_plan": {
    "doc": "google-doc-id-1",
    "tab": "t.0",
    "account": "you@forethought.org"
  },
  "first_run_lookback_hours": 24,
  "gmail": {
    "account": "you@forethought.org",
    "max": 50,
    "inbox_scan_max": 200,
    "noise_rules": [
      {
        "from": "@fireflies\\.ai$",
        "subject": "meeting recap",
        "reason": "Fireflies meeting recap; the meeting notes are kept elsewhere"
      },
      {
        "from": "@fireflies\\.ai$",
        "reason": "Fireflies account notice"
      },
      {
        "from": "^calendar-noreply@google\\.com$",
        "subject": "^(Accepted|Declined|Tentatively accepted)",
        "reason": "Calendar reply notification; the response is already on the event"
      },
      {
        "subject": "^(Updated invitation|Invitation)( with note)?:",
        "reason": "Calendar invitation; ft-desk's calendar check reports unanswered invitations, and you can respond in Calendar"
      },
      {
        "from": "^calendar-noreply@google\\.com$",
        "reason": "Google Calendar notice"
      },
      {
        "from": "@slack\\.com$",
        "reason": "Slack email notification; ft-desk reads Slack directly"
      },
      {
        "from": "^comments-noreply@docs\\.google\\.com$",
        "reason": "Docs comment notification; ft-desk's Docs check reads the comment directly",
        "covered_by": "gdocs"
      },
      {
        "from": "^drive-shares-dm-noreply@google\\.com$",
        "subject": "^Document shared with you:",
        "reason": "Docs share notification; ft-desk's Docs check reports new shares",
        "covered_by": "gdocs"
      },
      {
        "label": "CATEGORY_PROMOTIONS",
        "reason": "Promotional email"
      },
      {
        "label": "CATEGORY_SOCIAL",
        "reason": "Social network notification"
      }
    ]
  },
